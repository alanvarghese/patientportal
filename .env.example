# Local demo only. Choose a password and use the same value in DATABASE_URL.
POSTGRES_DB=telemedicine_demo
POSTGRES_USER=telemedicine
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://telemedicine:replace_with_a_local_password@127.0.0.1:5433/telemedicine_demo
# Optional WebRTC network services. Empty values support local same-device testing.
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Optional managed Cloudflare TURN (takes precedence over static TURN above).
# Store the long-lived token only on the backend, never in NEXT_PUBLIC_*.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
